{
  "name": "agentasia-voxel",
  "version": "0.1.0",
  "private": true,
  "description": "Talk it into the room. Sculpt it with your hands. A seated, hands-first mixed-reality block studio for Meta Quest 3 (WebXR).",
  "license": "MIT",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "npm run blueprints && tsc --noEmit && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "blueprints": "node scripts/genBlueprints.mjs",
    "e2e": "node scripts/e2e.mjs"
  },
  "dependencies": {
    "cannon-es": "^0.20.0",
    "three": "0.181.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/three": "0.181.0",
    "@types/webxr": "^0.5.24",
    "@vitejs/plugin-basic-ssl": "^2.0.0",
    "iwer": "2.6.0",
    "playwright-core": "1.56",
    "typescript": "^5.6.0",
    "vite": "^7.1.4",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=20.19.0"
  }
}
