# Server-side only (Vercel project env). Never put these in client code.
# LLM (OpenAI-compatible chat completions; Nebius Token Factory by default)
LLM_BASE_URL=https://api.tokenfactory.nebius.com/v1
LLM_API_KEY=
LLM_MODEL=nvidia/NVIDIA-Nemotron-3-Nano-30B-A3B
# Speech-to-text (AssemblyAI). Without it, the client uses on-device recognition when available.
ASSEMBLYAI_API_KEY=
# Optional OpenAI-compatible TTS (e.g. Kokoro-FastAPI). Male voice by default.
TTS_BASE_URL=
TTS_API_KEY=
TTS_VOICE=am_adam
# Comma-separated allowed origins for CORS (empty = same origin only)
ALLOWED_ORIGINS=
# "rules" forces the deterministic parser (no LLM calls)
AGENT_MODE=
